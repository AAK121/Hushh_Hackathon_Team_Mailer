# ==========================================
# BACKEND ENVIRONMENT VARIABLES TEMPLATE
# ==========================================
# Copy this to .env and fill in your actual values
# Instructions for getting each value are in comments below

# ==========================================
# SERVER CONFIGURATION
# ==========================================

# Server port (for Docker/Render, use 5000; for local, use 8001)
PORT=5000

# Server host (0.0.0.0 for production/Docker, 127.0.0.1 for local dev)
HOST=0.0.0.0

# Environment name (local, development, production)
VERCEL_ENV=production

# ==========================================
# SUPABASE CONFIGURATION
# Get from: https://supabase.com/dashboard > Settings > API
# ==========================================

# Supabase Project URL (example: https://xyz123abc.supabase.co)
SUPABASE_URL=https://your-project-url.supabase.co

# Supabase Anonymous Public Key
# Found in: Settings > API > Project API keys > anon public key
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (for backend operations - KEEP SECRET!)
# Found in: Settings > API > Project API keys > service_role secret
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase JWT Secret (for token verification)
# Found in: Settings > API > JWT Settings > JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase

# ==========================================
# GOOGLE APIS CONFIGURATION
# Get from: https://console.cloud.google.com
# ==========================================

# Google Gemini/Generative AI API Key (for AI functionalities)
# Create at: APIs & Services > Credentials > Create Credentials > API Key
GOOGLE_API_KEY=AIzaSy...

# Alternative name (backend checks both GOOGLE_API_KEY and GEMINI_API_KEY)
GEMINI_API_KEY=AIzaSy...

# Google OAuth Client ID (for Gmail/Calendar authentication)
# Create at: Credentials > Create OAuth 2.0 Client IDs (Desktop application)
GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com

# Google OAuth Client Secret
# Found in: Credentials > Your OAuth 2.0 Client IDs > Download JSON
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google OAuth Token URI
GOOGLE_OAUTH_TOKEN_URI=https://oauth2.googleapis.com/token

# ==========================================
# GMAIL & CALENDAR API CONFIGURATION
# ==========================================

# Gmail API scope
GMAIL_SCOPE=https://www.googleapis.com/auth/gmail.send

# Google Calendar API scope
GOOGLE_CALENDAR_SCOPE=https://www.googleapis.com/auth/calendar.events

# Sender email address (for outgoing emails)
SENDER_EMAIL=your-gmail-address@gmail.com

# ==========================================
# MAILJET CONFIGURATION (Email Service)
# Get from: https://app.mailjet.com > Account > API settings
# ==========================================

# Mailjet API Key
# Found in: Account > API settings > Your API keys > API Key
MAILJET_API_KEY=your-mailjet-api-key

# Mailjet API Secret
# Found in: Account > API settings > Your API keys > Secret Key
MAILJET_API_SECRET=your-mailjet-secret-key

# ==========================================
# FRONTEND CONFIGURATION
# ==========================================

# Frontend URL (your Vercel/production domain)
FRONTEND_URL=https://hushh-hackathon-team-mailer-1xcgl5fpr.vercel.app

# OAuth Redirect URL (typically same as FRONTEND_URL)
REDIRECT_URL=https://hushh-hackathon-team-mailer-1xcgl5fpr.vercel.app

# ==========================================
# RESEARCH AGENT CONFIGURATION (arXiv API)
# ==========================================

# arXiv API base URL (for research paper queries)
ARXIV_API_BASE_URL=http://export.arxiv.org/api/query

# arXiv abstract URL
ARXIV_ABS_BASE_URL=https://arxiv.org/abs

# arXiv PDF URL
ARXIV_PDF_BASE_URL=https://arxiv.org/pdf

# Maximum results from arXiv queries
ARXIV_MAX_RESULTS=10

# ==========================================
# OPTIONAL: SECURITY & ENCRYPTION
# ==========================================

# Secret key for session/token management
SECRET_KEY=your-secret-key-min-32-chars-recommended

# Vault encryption key (for secure credential storage)
VAULT_ENCRYPTION_KEY=your-encryption-key

# ==========================================
# OPTIONAL: VECTOR DB & CACHING
# ==========================================

# Pinecone vector database configuration (optional)
PINECONE_API_KEY=your-pinecone-api-key

# Redis URL (for caching, optional)
REDIS_URL=redis://localhost:6379/0

# ==========================================
# OPTIONAL: AGENT CONFIGURATION
# ==========================================

# Agent ID for tracking
AGENT_ID=agent_relationship_memory

# Development or Production
ENVIRONMENT=production

# API request timeout (seconds)
API_REQUEST_TIMEOUT=15

# ==========================================
# QUICK START GUIDE
# ==========================================
#
# 1. SUPABASE SETUP:
#    - Go to https://supabase.com and create a new project
#    - Get URL and keys from Settings > API
#    - Get JWT Secret from Settings > API > JWT Settings
#
# 2. GOOGLE CLOUD SETUP:
#    - Go to https://console.cloud.google.com
#    - Enable APIs: Gemini API, Gmail API, Google Calendar API
#    - Create API Key (for Gemini): APIs & Services > Credentials
#    - Create OAuth 2.0 Client ID: Credentials > Create > OAuth 2.0
#
# 3. MAILJET SETUP:
#    - Go to https://mailjet.com and create account
#    - Get API Key and Secret from Account > API settings
#
# 4. FOR PRODUCTION (Render):
#    - Copy all values from this file
#    - Go to Render dashboard > Your Web Service > Environment
#    - Add each variable one by one
#    - Redeploy the service
#
# 5. FOR LOCAL TESTING:
#    - Copy this file to .env in the backend folder
#    - Fill in all your actual values
#    - Run: python api.py
#    - Backend will be at http://localhost:8001