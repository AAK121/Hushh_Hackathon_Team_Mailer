{
  "version": 2,
  "builds": [
    {
      "src": "index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "pythonVersion": "3.11",
        "excludeFiles": [
          "__pycache__/**",
          "*.pyc",
          "tests/**",
          "docs/**",
          ".git/**",
          "*.md",
          "requirements_full.txt",
          "requirements_minimal.txt",
          ".env.local",
          "node_modules/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.py"
    }
  ],
  "env": {
    "PYTHONPATH": ".",
    "VERCEL_ENV": "production"
  },
  "regions": ["iad1"]
}
