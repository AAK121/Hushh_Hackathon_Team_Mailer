{
  "version": 2,
  "builds": [
    {
      "src": "index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "100mb",
        "excludeFiles": [
          "vault/**",
          "__pycache__/**",
          "*.pyc",
          "tests/**",
          "docs/**",
          ".git/**",
          "requirements_full.txt"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.py"
    }
  ],
  "env": {
    "PYTHONPATH": "."
  }
}
